# Gemini API key (gói trả phí). Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model cho lượt trích xuất chính và cho các lời gọi nhỏ (xem apps/worker/src/extract/pricing.ts)
GEMINI_MODEL_STRONG=gemini-4-argon
GEMINI_MODEL_FAST=gemini-3.8-flash
# Zotero Web API (bước 0.12). Key CHỈ ĐỌC cho Giai đoạn 1–1b. Tạo tại https://www.zotero.org/settings/keys
ZOTERO_API_KEY=your_zotero_read_only_key
# userID dạng số, hiện trên cùng trang settings/keys
ZOTERO_USER_ID=1234567
# Collection dùng làm Inbox, các cấp cách nhau bằng "/" (mặc định: Research Data / Inbox)
ZOTERO_INBOX_PATH=Research Data / Inbox
# Trần ngân sách Gemini (USD, D6: 10 USD cho pilot). Worker dừng TRƯỚC khi một lời gọi có thể vượt trần.
GEMINI_BUDGET_LIMIT=10
# Số tiền đã dùng trước khi có sổ chi tiêu (xem Google AI Studio, mục Billing); cộng vào tổng đã dùng
GEMINI_SPENT_OFFSET_USD=0
# (Tùy chọn) trần cho một lần chạy của worker
# GEMINI_RUN_LIMIT=2
# Giới hạn tốc độ theo gói của bạn (xem Google AI Studio): số lời gọi và số token mỗi phút
GEMINI_RPM=30
GEMINI_TPM=500000
