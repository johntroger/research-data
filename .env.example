# Gemini API key (gói trả phí). Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model cho lượt trích xuất chính và cho các lời gọi nhỏ (xem apps/worker/src/extract/pricing.ts)
GEMINI_MODEL_STRONG=gemini-4-argon
GEMINI_MODEL_FAST=gemini-3.8-flash
# Zotero Web API (bước 0.12). Key CHỈ ĐỌC cho Giai đoạn 1–1b. Tạo tại https://www.zotero.org/settings/keys
ZOTERO_API_KEY=your_zotero_read_only_key
# userID dạng số, hiện trên cùng trang settings/keys
ZOTERO_USER_ID=1234567
# Collection dùng làm Inbox, các cấp cách nhau bằng "/" (mặc định: Research Data / Inbox)
ZOTERO_INBOX_PATH=Research Data / Inbox
# Trần ngân sách Gemini (USD, D6: 25 USD cho pilot, nâng từ 10 lên 20 rồi 25 ngày 19/10/2026). Worker dừng TRƯỚC khi một lời gọi có thể vượt trần.
GEMINI_BUDGET_LIMIT=25
# Số tiền đã dùng trước khi có sổ chi tiêu (xem Google AI Studio, mục Billing); cộng vào tổng đã dùng
GEMINI_SPENT_OFFSET_USD=0
# (Tùy chọn) trần cho một lần chạy của worker
# GEMINI_RUN_LIMIT=2
# Giới hạn tốc độ theo gói của bạn (xem Google AI Studio): số lời gọi và số token mỗi phút
GEMINI_RPM=30
GEMINI_TPM=500000
# Thư mục gói việc cho tác tử ngoài (Codex…), NGOÀI repo để chúng không thấy .env (D16, Mục 4.5)
PACKETS_DIR=C:/Projects/Research Data Packets

# Unpaywall (Giai đoạn 2, bước 2.2c): địa chỉ email liên hệ mà Unpaywall yêu cầu trong mọi lời gọi.
UNPAYWALL_EMAIL=your_email@example.org
# Supabase prod (Giai đoạn 2): project, mật khẩu database và máy chủ pooler (mục Connect của Supabase). Chỉ để chạy worker với --target prod.
SUPABASE_PROD_REF=your_project_ref
SUPABASE_PROD_DB_PASSWORD=your_database_password
SUPABASE_PROD_POOLER_HOST=aws-0-ap-southeast-1.pooler.supabase.com

# Sao lưu hằng đêm (bước 2.4): bucket R2 riêng cho bản sao lưu và token đọc/ghi giới hạn đúng bucket đó.
# Nhập khóa bằng: powershell -File .\scripts\set-r2-keys.ps1 -Role backup ; rồi đẩy lên GitHub bằng scripts\set-github-secrets.ps1
R2_BACKUP_BUCKET=research-data-backups
R2_BACKUP_ACCESS_KEY_ID=your_backup_access_key_id
R2_BACKUP_SECRET_ACCESS_KEY=your_backup_secret_access_key
