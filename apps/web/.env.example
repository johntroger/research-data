# Supabase local (giá trị lấy từ: pnpm db:status). Không commit file .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key

# Cloudflare R2 (Giai đoạn 2): token chỉ đọc cho web. Nhập bằng: powershell -File .\scripts\set-r2-keys.ps1 -Role read
# Không có các biến này thì web đọc PDF trong thư mục raw_papers (chế độ phát triển).
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=research-data-pdfs
R2_ACCESS_KEY_ID=your_read_only_access_key_id
R2_SECRET_ACCESS_KEY=your_read_only_secret_access_key

# Chủ dự án (bước A.2): các email được đăng nhập làm chủ (ngăn cách bằng dấu phẩy). Tài khoản phải tồn tại trong Supabase Auth
# với app_metadata.role = owner (tắt đăng ký; tạo bằng API quản trị).
ADMIN_EMAILS=your_email@example.org

# Giới hạn tốc độ theo IP (bước A.5). Mặc định: bật khi chạy production, tắt khi phát triển; RATE_LIMIT=on|off để ép.
# TRUST_PROXY=1 chỉ đặt ở nơi có proxy ghi đè x-forwarded-for (Vercel); nếu không, mọi người dùng chung một xô đếm.
# RATE_LIMIT_SALT: muối cho mã băm IP (để trống thì mỗi lần chạy lấy một muối ngẫu nhiên).
RATE_LIMIT=
TRUST_PROXY=
RATE_LIMIT_SALT=
