{
  "name": "research-data",
  "private": true,
  "description": "Reference tool: AI-assisted, evidence-linked extraction of theories, constructs, hypotheses and statistics from academic papers.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "test:db": "vitest run --config vitest.db.config.ts",
    "pdf:inspect": "pnpm --filter @research-data/worker pdf:inspect",
    "extract:skeleton": "pnpm --filter @research-data/worker extract:skeleton",
    "verify:skeleton": "pnpm --filter @research-data/worker verify:skeleton",
    "publish:skeleton": "pnpm --filter @research-data/worker publish:skeleton",
    "web:dev": "pnpm --filter @research-data/web dev",
    "test:e2e": "pnpm --filter @research-data/web test:e2e",
    "docs:check": "node scripts/check-docs.mjs",
    "codebook:check": "node scripts/check-codebook.mjs",
    "schema:gemini-check": "pnpm --filter @research-data/worker schema:gemini-check",
    "zotero:inbox": "pnpm --filter @research-data/worker zotero:inbox",
    "synthetic:build": "pnpm --filter @research-data/worker synthetic:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "pdf-lib": "^1.17.1",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
